# cexd configuration. Every variable is optional; the defaults are shown.
# cexd reads the process environment only. It does NOT load this file by
# itself. Export the variables in your shell, or point docker compose's
# `env_file:` at a copy named .env (which git ignores).

# Listen address for the HTTP API.
CEX_HTTP_ADDR=:8080

# Directory for the WAL and snapshots. Must be on persistent storage.
CEX_DATA_DIR=./data

# debug | info | warn | error
CEX_LOG_LEVEL=info

# Maximum time allowed for graceful shutdown (Go duration: 500ms, 10s, 1m).
CEX_SHUTDOWN_TIMEOUT=10s

# JSON array of bearer credentials. Empty means protected routes deny all.
# Generate your own long random tokens; never commit real credentials.
# Each record: {"token":"at-least-16-characters","user_id":"1","admin":true}
# Same-user aliases must have identical admin roles; IDs are decimal strings.
CEX_API_TOKENS=[]

# Maximum commands per shared journal write + fsync (1 disables batching).
# Only already queued commands are grouped; there is no batching timer.
CEX_BATCH_SIZE=64

# Per authenticated user, shared by all their token aliases.
CEX_RATE_PER_SECOND=100
CEX_RATE_BURST=200

# HTTP timeouts. Write timeout must exceed request timeout.
CEX_REQUEST_TIMEOUT=5s
CEX_READ_HEADER_TIMEOUT=5s
CEX_READ_TIMEOUT=10s
CEX_WRITE_TIMEOUT=15s
CEX_IDLE_TIMEOUT=60s
