# cexd configuration. Every variable is optional; the defaults are shown.
# cexd reads the process environment only. It does NOT load this file by
# itself. Export the variables in your shell, or point docker compose's
# `env_file:` at a copy named .env (which git ignores).

# Listen address for the HTTP API.
CEX_HTTP_ADDR=:8080

# Directory for the WAL and snapshots. Must be on persistent storage.
CEX_DATA_DIR=./data

# debug | info | warn | error
CEX_LOG_LEVEL=info

# Maximum time allowed for graceful shutdown (Go duration: 500ms, 10s, 1m).
CEX_SHUTDOWN_TIMEOUT=10s
